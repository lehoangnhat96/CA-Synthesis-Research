{
	"servers": {
		"io.github.github/github-mcp-server": {
			"type": "stdio",
			"command": "npx.cmd",
			"args": [
				"-y",
				"@modelcontextprotocol/server-github"
			],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${input:token}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.4"
		}
	},
	"inputs": [
		{
			"id": "token",
			"type": "promptString",
			"description": "",
			"password": true
		}
	]
}